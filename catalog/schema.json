          "null"
        ]
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "upstream_description": {
        "type": [
          "string",
          "null"
        ]
      },
      "license": {
        "type": [
          "string",
          "null"
        ]
      },
      "license_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "type": [
          "string",
          "null"
        ]
      },
      "last_verified": {
        "type": [
          "string",
          "null"
        ]
      },
      "last_attempted": {
        "type": [
          "string",
          "null"
        ]
      },
      "readme_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "documentation_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "readme_excerpt": {
        "type": [
          "string",
          "null"
        ]
      },
      "readme_error": {
        "type": [
          "string",
          "null"
        ]
      },
      "metadata_error": {
        "type": [
          "string",
          "null"
        ]
      },
      "upstream_pushed_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "fork_outcome": {
        "type": [
          "string",
          "null"
        ]
      },
      "classification_evidence": {
        "type": [
          "string",
          "null"
        ]
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "upstream_topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "technologies": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "compatible_ai_tools": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "use_cases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "installation_requirements": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "previous_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "id": {
        "type": [
          "integer",
          "null"
        ]
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "status": {
        "enum": [
          "active",
          "archived",
          "unavailable",
          "unverified"
        ]
      },
      "fork_status": {
        "enum": [
          "pending",
          "confirmed",
          "failed"
        ]
      },
      "classification_status": {
        "enum": [
          "needs_review",
          "suggested",
          "reviewed"
        ]
      },
      "upstream_changed": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
