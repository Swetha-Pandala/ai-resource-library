{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "original_url",
      "upstream_topics",
      "fork_error",
      "readme_error",
      "aliases",
      "fork_status",
      "compatible_ai_tools",
      "last_verified",
      "license_url",
      "date_added",
      "category",
      "fork_url",
      "installation_requirements",
      "upstream_changed",
      "readme_excerpt",
      "id",
      "tags",
      "documentation_url",
      "upstream_description",
      "upstream_pushed_at",
      "metadata_error",
      "canonical_url",
      "fork_outcome",
      "description",
      "license",
      "readme_url",
      "language",
      "use_cases",
      "status",
      "name",
      "classification_status",
      "previous_names",
      "last_attempted",
      "technologies",
      "notes"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "original_url": {
        "type": "string"
      },
      "canonical_url": {
        "type": "string"
